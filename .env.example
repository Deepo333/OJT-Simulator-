# Database — SQLite for Stage 1 (Prisma-compatible; migrate to Postgres by
# swapping the datasource provider + DATABASE_URL).
DATABASE_URL="file:./dev.db"

# Anthropic API key — required for job analysis.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional: override the model used by the analyzer.
# Defaults to a current Claude Sonnet model.
ANTHROPIC_MODEL="claude-sonnet-4-5"
